{
  "$schema": "../../schemas/globe_project.schema.json",
  "schema_version": "1.0",
  "metadata": {
    "id": "02_airy_vs_crust1_moho",
    "name": "Paper 02: Airy Isostasy & CRUST1.0 Moho Depth Globe",
    "description": "Hollow isostatic Earth model where the outer surface displays 35x surface topography (ETOPO) while the inner cavity (inner_ratio=0.75) mirrors deep continental crustal roots (Himalayas, Andes) via Airy Moho calculation.",
    "category": "paper_recreations",
    "collection": "Paper Recreations",
    "author": "Laske et al. (2013) / Globe3D Studio",
    "tags": ["crust", "moho", "isostasy", "airy", "crust1", "inner-displacement"]
  },
  "mode": "custom",
  "paleo_config": {
    "enabled": false,
    "age": 0.0,
    "name": null,
    "resolution": "6m",
    "plate_model": "PALEOMAP",
    "data_dir": null,
    "vert_exagg": 40.0,
    "coastline_step": 0.0,
    "color_mode": "paleoatlas",
    "cmap": "terrain",
    "filament_spools": [],
    "band_thresholds": [],
    "tracked_locations": [],
    "mark_poles": false,
    "pole_style": "NS_letters",
    "pole_label_size_deg": 5.0,
    "location_marker_size_deg": 3.5
  },
  "geometry": {
    "distribution": "fibonacci",
    "n_points": 300000,
    "preview_n_points": 35000,
    "radius": 40.0,
    "center": [0.0, 0.0, 0.0],
    "hollow": true,
    "inner_ratio": 0.75,
    "inner_n_points": 45000,
    "create_inner_mesh_from_outer_thickness": null,
    "fix_intersection": {
      "enabled": true,
      "min_thickness": 1.8,
      "mode": "inner"
    }
  },
  "grids": [
    {
      "id": "etopo_crust",
      "source": "online",
      "dataset": "topography.earth",
      "params": {
        "resolution": "15m"
      },
      "filepath": "../inputs/ETOPO_2022_v1_60s_N90W180_surface.nc",
      "synthetic_type": null,
      "ops": []
    },
    {
      "id": "airy_moho_depth",
      "source": "online",
      "dataset": "topography.earth",
      "params": {
        "resolution": "15m"
      },
      "filepath": "../inputs/ETOPO_2022_v1_60s_N90W180_surface.nc",
      "synthetic_type": null,
      "ops": [
        {
          "op": "airy_moho",
          "t0_km": 30.0,
          "ocean_scale": 4.45,
          "land_scale": 6.6
        }
      ]
    }
  ],
  "outer_displacements": [
    {
      "id": "disp_surface_topo_30x",
      "name": "Surface Topography (30x Exaggeration)",
      "type": "GridDisplacer",
      "enabled": true,
      "grid_id": "etopo_crust",
      "scale_mode": "auto_exagg",
      "scale": 0.00019,
      "vert_exagg": 30.0,
      "data_unit": "m",
      "reference_level": 0.0,
      "coastline_step": 0.6,
      "step_threshold": 0.0,
      "points": [],
      "lines": [],
      "polygons": [],
      "shapefile": null,
      "value": 0.0,
      "radius_deg": 2.0,
      "width_deg": 0.5,
      "profile": "flat",
      "height": 0.0,
      "mode": "add"
    }
  ],
  "inner_displacements": [
    {
      "id": "disp_airy_moho_inner",
      "name": "Airy Isostatic Moho Root Relief (30x, ref=-30 km)",
      "type": "GridDisplacer",
      "enabled": true,
      "grid_id": "airy_moho_depth",
      "scale_mode": "auto_exagg",
      "scale": 0.00019,
      "vert_exagg": 30.0,
      "data_unit": "m",
      "reference_level": -30000.0,
      "coastline_step": 0.0,
      "step_threshold": 0.0,
      "points": [],
      "lines": [],
      "polygons": [],
      "shapefile": null,
      "value": 0.0,
      "radius_deg": 2.0,
      "width_deg": 0.5,
      "profile": "flat",
      "height": 0.0,
      "mode": "add"
    }
  ],
  "colourers": [
    {
      "id": "col_outer_crust_terrain",
      "name": "Surface Hypsometry ('terrain')",
      "type": "GridColourer",
      "enabled": true,
      "target": "outer",
      "selection": "outward_facing",
      "blend_mode": "replace",
      "opacity": 1.0,
      "grid_id": "etopo_crust",
      "cmap": "terrain",
      "vmin": -6000.0,
      "vmax": 6000.0,
      "symmetric": true,
      "use_banded_levels": false,
      "levels": [],
      "colors": [],
      "image_source": null,
      "image_path": null,
      "preprocessors": [],
      "color": null,
      "points": [],
      "lines": [],
      "polygons": [],
      "shapefile": null,
      "radius_deg": 2.0,
      "width_deg": 0.5,
      "feather_deg": 0.1,
      "symbol": null,
      "lat": null,
      "lon": null,
      "size_deg": 4.0,
      "rotation_deg": 0.0,
      "text": null,
      "font_path": null,
      "mark_north": false,
      "mark_south": false,
      "north_text": "N",
      "south_text": "S"
    },
    {
      "id": "col_inner_moho_viridis",
      "name": "Moho Root Depth Colormap ('plasma')",
      "type": "GridColourer",
      "enabled": true,
      "target": "inner",
      "selection": "all",
      "blend_mode": "replace",
      "opacity": 1.0,
      "grid_id": "airy_moho_depth",
      "cmap": "plasma",
      "vmin": -65000.0,
      "vmax": -10000.0,
      "symmetric": false,
      "use_banded_levels": false,
      "levels": [],
      "colors": [],
      "image_source": null,
      "image_path": null,
      "preprocessors": [],
      "color": null,
      "points": [],
      "lines": [],
      "polygons": [],
      "shapefile": null,
      "radius_deg": 2.0,
      "width_deg": 0.5,
      "feather_deg": 0.1,
      "symbol": null,
      "lat": null,
      "lon": null,
      "size_deg": 4.0,
      "rotation_deg": 0.0,
      "text": null,
      "font_path": null,
      "mark_north": false,
      "mark_south": false,
      "north_text": "N",
      "south_text": "S"
    }
  ],
  "filaments": {
    "enabled": false,
    "preset": "TERRAIN_4",
    "spools": [],
    "base_layers": 3,
    "top_layers": 4,
    "layer_height": 0.16,
    "quantize_preview": false
  },
  "magnets": {
    "enabled": true,
    "count": 3,
    "Optimize_positions": true,
    "optimize_positions": true,
    "diameter": 5.0,
    "height": 2.0,
    "clearance": 0.15,
    "min_margin": 1.5,
    "boss_thickness": 1.8,
    "manual_angles": [],
    "magnet_type": "cylindrical",
    "width": 5.0,
    "length": 10.0,
    "embed_depth": 0.2
  },
  "export": {
    "split_hemispheres": true,
    "format": "obj",
    "dual_files": true,
    "filament_mode": "vertex_color",
    "output_dir": "outputs",
    "filename_prefix": "paper_02_airy_moho_globe"
  }
}
