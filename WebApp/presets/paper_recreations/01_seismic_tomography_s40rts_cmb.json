{
  "$schema": "../../schemas/globe_project.schema.json",
  "schema_version": "1.0",
  "metadata": {
    "id": "01_seismic_tomography_s40rts_cmb",
    "name": "Paper 01: S40RTS Core-Mantle Boundary (2850 km) Tomography Globe",
    "description": "Recreates the dual-surface mantle tomography globe: outer shell displaced by ETOPO + S40RTS (2850 km LLSVPs), inner cavity displaced by CMB shear-wave velocity anomalies, coloured with 'RdBu_r'.",
    "category": "paper_recreations",
    "collection": "Paper Recreations",
    "author": "Ritsema et al. (2011) / Globe3D Studio",
    "tags": ["tomography", "s40rts", "cmb", "llsvp", "mantle", "seismology"]
  },
  "mode": "custom",
  "paleo_config": {
    "enabled": false,
    "age": 0.0,
    "name": null,
    "resolution": "6m",
    "plate_model": "PALEOMAP",
    "data_dir": null,
    "vert_exagg": 40.0,
    "coastline_step": 0.0,
    "color_mode": "paleoatlas",
    "cmap": "terrain",
    "filament_spools": [],
    "band_thresholds": [],
    "tracked_locations": [],
    "mark_poles": false,
    "pole_style": "NS_letters",
    "pole_label_size_deg": 5.0,
    "location_marker_size_deg": 3.5
  },
  "geometry": {
    "distribution": "fibonacci",
    "n_points": 500000,
    "preview_n_points": 40000,
    "radius": 45.0,
    "center": [0.0, 0.0, 0.0],
    "hollow": true,
    "inner_ratio": 0.55,
    "inner_n_points": 40000,
    "create_inner_mesh_from_outer_thickness": null,
    "fix_intersection": {
      "enabled": true,
      "min_thickness": 1.6,
      "mode": "inner"
    }
  },
  "grids": [
    {
      "id": "etopo_surface",
      "source": "online",
      "dataset": "topography.earth",
      "params": {
        "resolution": "15m"
      },
      "filepath": "../inputs/ETOPO_2022_v1_60s_N90W180_surface.nc",
      "synthetic_type": null,
      "ops": []
    },
    {
      "id": "s40rts_2850km",
      "source": "online",
      "dataset": "tomography.s40rts",
      "params": {
        "depth": 2850.0
      },
      "filepath": "../inputs/s40_depth_slice_2850.grd",
      "synthetic_type": null,
      "ops": []
    }
  ],
  "outer_displacements": [
    {
      "id": "disp_etopo_outer",
      "name": "Surface Topography (35x ETOPO)",
      "type": "GridDisplacer",
      "enabled": true,
      "grid_id": "etopo_surface",
      "scale_mode": "auto_exagg",
      "scale": 0.00025,
      "vert_exagg": 35.0,
      "data_unit": "m",
      "reference_level": 0.0,
      "coastline_step": 0.75,
      "step_threshold": 0.0,
      "points": [],
      "lines": [],
      "polygons": [],
      "shapefile": null,
      "value": 0.0,
      "radius_deg": 2.0,
      "width_deg": 0.5,
      "profile": "flat",
      "height": 0.0,
      "mode": "add"
    },
    {
      "id": "disp_s40rts_outer_swell",
      "name": "LLSVP Superplume Swell (-0.6 mm/% dVs)",
      "type": "GridDisplacer",
      "enabled": true,
      "grid_id": "s40rts_2850km",
      "scale_mode": "explicit",
      "scale": -0.6,
      "vert_exagg": 1.0,
      "data_unit": "pct",
      "reference_level": 0.0,
      "coastline_step": 0.0,
      "step_threshold": 0.0,
      "points": [],
      "lines": [],
      "polygons": [],
      "shapefile": null,
      "value": 0.0,
      "radius_deg": 2.0,
      "width_deg": 0.5,
      "profile": "flat",
      "height": 0.0,
      "mode": "add"
    }
  ],
  "inner_displacements": [
    {
      "id": "disp_s40rts_inner_cmb",
      "name": "CMB Tomography Cavity Relief (0.9 mm/% dVs)",
      "type": "GridDisplacer",
      "enabled": true,
      "grid_id": "s40rts_2850km",
      "scale_mode": "explicit",
      "scale": 0.9,
      "vert_exagg": 1.0,
      "data_unit": "pct",
      "reference_level": 0.0,
      "coastline_step": 0.0,
      "step_threshold": 0.0,
      "points": [],
      "lines": [],
      "polygons": [],
      "shapefile": null,
      "value": 0.0,
      "radius_deg": 2.0,
      "width_deg": 0.5,
      "profile": "flat",
      "height": 0.0,
      "mode": "add"
    }
  ],
  "colourers": [
    {
      "id": "col_s40rts_rdbu",
      "name": "S40RTS Shear Velocity Anomaly (RdBu_r, -2.5% to +2.5%)",
      "type": "GridColourer",
      "enabled": true,
      "target": "all",
      "selection": "all",
      "blend_mode": "replace",
      "opacity": 1.0,
      "grid_id": "s40rts_2850km",
      "cmap": "RdBu_r",
      "vmin": -2.5,
      "vmax": 2.5,
      "symmetric": true,
      "use_banded_levels": false,
      "levels": [],
      "colors": [],
      "image_source": null,
      "image_path": null,
      "preprocessors": [],
      "color": null,
      "points": [],
      "lines": [],
      "polygons": [],
      "shapefile": null,
      "radius_deg": 2.0,
      "width_deg": 0.5,
      "feather_deg": 0.1,
      "symbol": null,
      "lat": null,
      "lon": null,
      "size_deg": 4.0,
      "rotation_deg": 0.0,
      "text": null,
      "font_path": null,
      "mark_north": false,
      "mark_south": false,
      "north_text": "N",
      "south_text": "S"
    },
    {
      "id": "col_coastline_overlay",
      "name": "Continental Coastline Reference Outline",
      "type": "LineColourer",
      "enabled": true,
      "target": "outer",
      "selection": "outward_facing",
      "blend_mode": "replace",
      "opacity": 1.0,
      "grid_id": null,
      "cmap": "terrain",
      "vmin": null,
      "vmax": null,
      "symmetric": false,
      "use_banded_levels": false,
      "levels": [],
      "colors": [],
      "image_source": null,
      "image_path": null,
      "preprocessors": [],
      "color": "#1E293B",
      "points": [],
      "lines": [],
      "polygons": [],
      "shapefile": "coastline",
      "radius_deg": 1.0,
      "width_deg": 0.4,
      "feather_deg": 0.1,
      "symbol": null,
      "lat": null,
      "lon": null,
      "size_deg": 4.0,
      "rotation_deg": 0.0,
      "text": null,
      "font_path": null,
      "mark_north": false,
      "mark_south": false,
      "north_text": "N",
      "south_text": "S"
    }
  ],
  "filaments": {
    "enabled": false,
    "preset": "RBYKW",
    "spools": [],
    "base_layers": 3,
    "top_layers": 4,
    "layer_height": 0.16,
    "quantize_preview": false
  },
  "magnets": {
    "enabled": true,
    "count": 4,
    "Optimize_positions": true,
    "optimize_positions": true,
    "diameter": 5.0,
    "height": 2.0,
    "clearance": 0.15,
    "min_margin": 1.5,
    "boss_thickness": 1.8,
    "manual_angles": [],
    "magnet_type": "cylindrical",
    "width": 5.0,
    "length": 10.0,
    "embed_depth": 0.2
  },
  "export": {
    "split_hemispheres": true,
    "format": "obj",
    "dual_files": true,
    "filament_mode": "vertex_color",
    "output_dir": "outputs",
    "filename_prefix": "paper_01_s40rts_cmb"
  }
}
