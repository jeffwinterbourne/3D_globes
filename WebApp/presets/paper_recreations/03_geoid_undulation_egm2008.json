{
  "$schema": "../../schemas/globe_project.schema.json",
  "schema_version": "1.0",
  "metadata": {
    "id": "03_geoid_undulation_egm2008",
    "name": "Paper 03: EGM2008 Geoid Undulation & Topography Composite",
    "description": "Weighted composite globe combining long-wavelength EGM2008 geoid height undulations (-106m Indian Ocean low to +85m New Guinea high, weighted 300x) with sharp surface topography and coastline steps.",
    "category": "paper_recreations",
    "collection": "Paper Recreations",
    "author": "Pavlis et al. (2012) / Globe3D Studio",
    "tags": ["geoid", "egm2008", "gravity", "composite", "undulation"]
  },
  "mode": "custom",
  "paleo_config": {
    "enabled": false,
    "age": 0.0,
    "name": null,
    "resolution": "6m",
    "plate_model": "PALEOMAP",
    "data_dir": null,
    "vert_exagg": 40.0,
    "coastline_step": 0.0,
    "color_mode": "paleoatlas",
    "cmap": "terrain",
    "filament_spools": [],
    "band_thresholds": [],
    "tracked_locations": [],
    "mark_poles": false,
    "pole_style": "NS_letters",
    "pole_label_size_deg": 5.0,
    "location_marker_size_deg": 3.5
  },
  "geometry": {
    "distribution": "fibonacci",
    "n_points": 300000,
    "preview_n_points": 35000,
    "radius": 40.0,
    "center": [0.0, 0.0, 0.0],
    "hollow": true,
    "inner_ratio": 0.55,
    "inner_n_points": 30000,
    "create_inner_mesh_from_outer_thickness": null,
    "fix_intersection": {
      "enabled": true,
      "min_thickness": 1.6,
      "mode": "inner"
    }
  },
  "grids": [
    {
      "id": "etopo_geoid_base",
      "source": "online",
      "dataset": "topography.earth",
      "params": {
        "resolution": "15m"
      },
      "filepath": "../inputs/ETOPO_2022_v1_60s_N90W180_surface.nc",
      "synthetic_type": null,
      "ops": []
    },
    {
      "id": "egm2008_geoid",
      "source": "online",
      "dataset": "geoid.egm2008",
      "params": {},
      "filepath": "../inputs/egm2008_geoid.grd",
      "synthetic_type": null,
      "ops": []
    },
    {
      "id": "geoid_topo_composite",
      "source": "online",
      "dataset": "topography.earth",
      "params": {
        "resolution": "15m"
      },
      "filepath": "../inputs/ETOPO_2022_v1_60s_N90W180_surface.nc",
      "synthetic_type": null,
      "ops": [
        {
          "op": "composite",
          "inputs": [
            { "grid_id": "etopo_geoid_base", "weight": 1.0 },
            { "grid_id": "egm2008_geoid", "weight": 300.0 }
          ],
          "normalize": false,
          "clamp_min": null,
          "clamp_max": null
        }
      ]
    }
  ],
  "outer_displacements": [
    {
      "id": "disp_geoid_composite",
      "name": "Weighted Composite (1x ETOPO + 300x EGM2008, 40x Scale)",
      "type": "GridDisplacer",
      "enabled": true,
      "grid_id": "geoid_topo_composite",
      "scale_mode": "auto_exagg",
      "scale": 0.00025,
      "vert_exagg": 40.0,
      "data_unit": "m",
      "reference_level": 0.0,
      "coastline_step": 0.8,
      "step_threshold": 0.0,
      "points": [],
      "lines": [],
      "polygons": [],
      "shapefile": null,
      "value": 0.0,
      "radius_deg": 2.0,
      "width_deg": 0.5,
      "profile": "flat",
      "height": 0.0,
      "mode": "add"
    }
  ],
  "inner_displacements": [],
  "colourers": [
    {
      "id": "col_geoid_coolwarm",
      "name": "EGM2008 Geoid Height Anomaly ('coolwarm', -105m to +85m)",
      "type": "GridColourer",
      "enabled": true,
      "target": "outer",
      "selection": "outward_facing",
      "blend_mode": "replace",
      "opacity": 1.0,
      "grid_id": "egm2008_geoid",
      "cmap": "coolwarm",
      "vmin": -100.0,
      "vmax": 100.0,
      "symmetric": true,
      "use_banded_levels": false,
      "levels": [],
      "colors": [],
      "image_source": null,
      "image_path": null,
      "preprocessors": [],
      "color": null,
      "points": [],
      "lines": [],
      "polygons": [],
      "shapefile": null,
      "radius_deg": 2.0,
      "width_deg": 0.5,
      "feather_deg": 0.1,
      "symbol": null,
      "lat": null,
      "lon": null,
      "size_deg": 4.0,
      "rotation_deg": 0.0,
      "text": null,
      "font_path": null,
      "mark_north": false,
      "mark_south": false,
      "north_text": "N",
      "south_text": "S"
    },
    {
      "id": "col_geoid_coastline",
      "name": "Coastline Reference Outline",
      "type": "LineColourer",
      "enabled": true,
      "target": "outer",
      "selection": "outward_facing",
      "blend_mode": "replace",
      "opacity": 1.0,
      "grid_id": null,
      "cmap": "terrain",
      "vmin": null,
      "vmax": null,
      "symmetric": false,
      "use_banded_levels": false,
      "levels": [],
      "colors": [],
      "image_source": null,
      "image_path": null,
      "preprocessors": [],
      "color": "#0F172A",
      "points": [],
      "lines": [],
      "polygons": [],
      "shapefile": "coastline",
      "radius_deg": 1.0,
      "width_deg": 0.4,
      "feather_deg": 0.1,
      "symbol": null,
      "lat": null,
      "lon": null,
      "size_deg": 4.0,
      "rotation_deg": 0.0,
      "text": null,
      "font_path": null,
      "mark_north": false,
      "mark_south": false,
      "north_text": "N",
      "south_text": "S"
    }
  ],
  "filaments": {
    "enabled": false,
    "preset": "TERRAIN_4",
    "spools": [],
    "base_layers": 3,
    "top_layers": 4,
    "layer_height": 0.16,
    "quantize_preview": false
  },
  "magnets": {
    "enabled": true,
    "count": 3,
    "Optimize_positions": true,
    "optimize_positions": true,
    "diameter": 5.0,
    "height": 2.0,
    "clearance": 0.15,
    "min_margin": 1.5,
    "boss_thickness": 1.8,
    "manual_angles": [],
    "magnet_type": "cylindrical",
    "width": 5.0,
    "length": 10.0,
    "embed_depth": 0.2
  },
  "export": {
    "split_hemispheres": true,
    "format": "obj",
    "dual_files": true,
    "filament_mode": "vertex_color",
    "output_dir": "outputs",
    "filename_prefix": "paper_03_geoid_egm2008"
  }
}
