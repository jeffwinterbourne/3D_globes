{
  "$schema": "../../schemas/globe_project.schema.json",
  "schema_version": "1.0",
  "metadata": {
    "id": "08_lithosphere_asthenosphere_boundary",
    "name": "Paper 08: Lithosphere-Asthenosphere Boundary (LAB) & Cratonic Keels",
    "description": "Dual-surface lithospheric thickness globe: outer surface shows 35x ETOPO relief while the inner cavity (inner_ratio=0.72) is displaced by the LITHO1.0 / Priestley LAB depth showing >250 km Archean cratonic keels.",
    "category": "paper_recreations",
    "collection": "Paper Recreations",
    "author": "Pasyanos et al. (2014) / Globe3D Studio",
    "tags": ["lithosphere", "lab", "cratons", "keels", "litho1", "inner-displacement"]
  },
  "mode": "custom",
  "paleo_config": {
    "enabled": false,
    "age": 0.0,
    "name": null,
    "resolution": "6m",
    "plate_model": "PALEOMAP",
    "data_dir": null,
    "vert_exagg": 35.0,
    "coastline_step": 0.0,
    "color_mode": "paleoatlas",
    "cmap": "terrain",
    "filament_spools": [],
