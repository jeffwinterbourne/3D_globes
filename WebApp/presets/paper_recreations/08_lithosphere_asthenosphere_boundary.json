    "tracked_locations": [],
    "mark_poles": false,
    "pole_style": "NS_letters",
    "pole_label_size_deg": 5.0,
    "location_marker_size_deg": 3.5
  },
  "geometry": {
    "distribution": "fibonacci",
    "n_points": 300000,
    "preview_n_points": 35000,
    "radius": 42.0,
    "center": [0.0, 0.0, 0.0],
    "hollow": true,
    "inner_ratio": 0.72,
    "inner_n_points": 40000,
    "create_inner_mesh_from_outer_thickness": null,
    "fix_intersection": {
      "enabled": true,
      "min_thickness": 1.8,
      "mode": "inner"
    }
  },
