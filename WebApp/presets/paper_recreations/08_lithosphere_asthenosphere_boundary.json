      "value": 0.0,
      "radius_deg": 2.0,
      "width_deg": 0.5,
      "profile": "flat",
      "height": 0.0,
      "mode": "add"
    }
  ],
  "inner_displacements": [
    {
      "id": "disp_lab_inner_keels",
      "name": "LAB Cratonic Keel Depth (12x Exaggeration, ref=-100 km)",
      "type": "GridDisplacer",
      "enabled": true,
      "grid_id": "litho_lab_depth",
      "scale_mode": "auto_exagg",
      "scale": 0.00008,
      "vert_exagg": 12.0,
