      "filepath": "../inputs/ETOPO_2022_v1_60s_N90W180_surface.nc",
      "synthetic_type": null,
      "ops": []
    },
    {
      "id": "litho_lab_depth",
      "source": "online",
      "dataset": "lithosphere.thickness",
      "params": {
        "layer": "lab"
      },
      "filepath": null,
      "synthetic_type": null,
      "ops": [
        {
          "op": "scale_offset",
          "scale": -1000.0,
          "offset": 0.0
        }
      ]
    }
  ],
  "outer_displacements": [
    {
      "id": "disp_lab_outer_topo",
      "name": "Surface Topography (35x ETOPO + 0.7mm Coast Step)",
      "type": "GridDisplacer",
      "enabled": true,
      "grid_id": "etopo_lab_outer",
      "scale_mode": "auto_exagg",
      "scale": 0.00023,
      "vert_exagg": 35.0,
      "data_unit": "m",
      "reference_level": 0.0,
      "coastline_step": 0.7,
      "step_threshold": 0.0,
      "points": [],
      "lines": [],
      "polygons": [],
