      "points": [],
      "lines": [],
      "polygons": [],
      "shapefile": null,
      "radius_deg": 2.0,
      "width_deg": 0.5,
      "feather_deg": 0.1,
      "symbol": null,
      "lat": null,
      "lon": null,
      "size_deg": 4.0,
      "rotation_deg": 0.0,
      "text": null,
      "font_path": null,
      "mark_north": false,
      "mark_south": false,
      "north_text": "N",
      "south_text": "S"
    },
    {
      "id": "col_inner_cavity_gray",
      "name": "Inner Cavity Neutral Gray",
      "type": "ConstantColourer",
      "enabled": true,
      "target": "inner",
      "selection": "all",
      "blend_mode": "replace",
      "opacity": 1.0,
      "grid_id": null,
      "cmap": "terrain",
      "vmin": null,
      "vmax": null,
      "symmetric": false,
      "use_banded_levels": false,
      "levels": [],
      "colors": [],
      "image_source": null,
      "image_path": null,
      "preprocessors": [],
      "color": "#94A3B8",
      "points": [],
      "lines": [],
      "polygons": [],
      "shapefile": null,
      "radius_deg": 2.0,
      "width_deg": 0.5,
      "feather_deg": 0.1,
      "symbol": null,
      "lat": null,
      "lon": null,
      "size_deg": 4.0,
      "rotation_deg": 0.0,
      "text": null,
      "font_path": null,
      "mark_north": false,
      "mark_south": false,
      "north_text": "N",
      "south_text": "S"
    }
  ],
  "filaments": {
    "enabled": false,
    "preset": "TERRAIN_4",
    "spools": [],
    "base_layers": 3,
    "top_layers": 4,
    "layer_height": 0.16,
    "quantize_preview": false
  },
  "magnets": {
    "enabled": true,
    "count": 4,
    "Optimize_positions": true,
    "optimize_positions": true,
    "diameter": 5.0,
    "height": 2.0,
    "clearance": 0.15,
    "min_margin": 1.5,
    "boss_thickness": 1.8,
    "manual_angles": [0.0, 90.0, 180.0, 270.0],
    "magnet_type": "cylindrical",
    "width": 5.0,
    "length": 10.0,
    "embed_depth": 0.2
  },
  "export": {
    "split_hemispheres": true,
    "format": "stl",
    "dual_files": true,
    "filament_mode": "monochrome",
    "output_dir": "outputs",
    "filename_prefix": "example_2_hollow_globe"
  }
