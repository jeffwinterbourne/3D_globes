{
  "$schema": "../../schemas/globe_project.schema.json",
  "schema_version": "1.0",
  "metadata": {
    "id": "example_2_hollow_globe",
    "name": "Example 2: Hollow Globe with Equatorial Split & Magnets",
    "description": "Hollow 40mm Earth globe (inner_ratio=0.55) with 40x ETOPO topography, 0.8mm coastline step, split into Northern and Southern hemispheres with 4 equatorial 5x2mm magnets.",
    "category": "examples",
    "collection": "Standard Examples",
    "author": "Globe3D Studio",
    "tags": ["hollow", "hemispheres", "magnets", "etopo", "coastline"]
  },
  "mode": "custom",
  "paleo_config": {
    "enabled": false,
    "age": 0.0,
    "name": null,
    "resolution": "6m",
    "plate_model": "PALEOMAP",
    "data_dir": null,
    "vert_exagg": 40.0,
    "coastline_step": 0.0,
    "color_mode": "paleoatlas",
    "cmap": "terrain",
    "filament_spools": [],
    "band_thresholds": [],
    "tracked_locations": [],
    "mark_poles": false,
    "pole_style": "NS_letters",
    "pole_label_size_deg": 5.0,
    "location_marker_size_deg": 3.5
  },
  "geometry": {
    "distribution": "fibonacci",
    "n_points": 120000,
    "preview_n_points": 30000,
    "radius": 40.0,
    "center": [0.0, 0.0, 0.0],
    "hollow": true,
    "inner_ratio": 0.55,
    "inner_n_points": 30000,
    "create_inner_mesh_from_outer_thickness": null,
    "fix_intersection": {
      "enabled": true,
      "min_thickness": 1.6,
      "mode": "inner"
    }
  },
  "grids": [
    {
      "id": "earth_topo",
      "source": "online",
      "dataset": "topography.earth",
      "params": {
        "resolution": "15m"
      },
      "filepath": "../inputs/ETOPO_2022_v1_60s_N90W180_surface.nc",
      "synthetic_type": null,
      "ops": [
        {
          "op": "downsample",
          "factor": 2
        }
      ]
    }
  ],
  "outer_displacements": [
    {
      "id": "disp_etopo",
      "name": "ETOPO 2022 Relief (40x)",
      "type": "GridDisplacer",
      "enabled": true,
      "grid_id": "earth_topo",
      "scale_mode": "auto_exagg",
      "scale": 0.00025,
      "vert_exagg": 40.0,
      "data_unit": "m",
      "reference_level": 0.0,
      "coastline_step": 0.8,
      "step_threshold": 0.0,
      "points": [],
      "lines": [],
      "polygons": [],
      "shapefile": null,
      "value": 0.0,
      "radius_deg": 2.0,
      "width_deg": 0.5,
      "profile": "flat",
      "height": 0.0,
      "mode": "add"
    }
  ],
  "inner_displacements": [],
  "colourers": [
    {
      "id": "col_outer_ocean_blue",
      "name": "Outer Shell Slate Blue",
      "type": "ConstantColourer",
      "enabled": true,
      "target": "outer",
      "selection": "outward_facing",
      "blend_mode": "replace",
      "opacity": 1.0,
      "grid_id": null,
      "cmap": "terrain",
      "vmin": null,
      "vmax": null,
      "symmetric": false,
      "use_banded_levels": false,
      "levels": [],
      "colors": [],
      "image_source": null,
      "image_path": null,
