{
  "$schema": "../../schemas/globe_project.schema.json",
  "schema_version": "1.0",
  "metadata": {
    "id": "example_1_procedural_globe",
    "name": "Example 1: Procedural Spherical Harmonic Globe",
    "description": "Solid 40mm Fibonacci sphere (30k pts) displaced by a synthetic spherical harmonic wave grid and coloured with the 'viridis' colormap. Ideal zero-download starter globe.",
    "category": "examples",
    "collection": "Standard Examples",
    "author": "Globe3D Studio",
    "tags": ["starter", "synthetic", "procedural", "fibonacci", "solid", "stl"]
  },
  "mode": "custom",
  "paleo_config": {
    "enabled": false,
    "age": 250.0,
    "name": null,
    "resolution": "6m",
    "plate_model": "PALEOMAP",
    "data_dir": null,
    "vert_exagg": 40.0,
    "coastline_step": 0.0,
    "color_mode": "paleoatlas",
    "cmap": "terrain",
    "filament_spools": [],
    "band_thresholds": [],
    "tracked_locations": [],
    "mark_poles": false,
    "pole_style": "NS_letters",
    "pole_label_size_deg": 5.0,
    "location_marker_size_deg": 3.5
  },
  "geometry": {
    "distribution": "fibonacci",
    "n_points": 50000,
    "preview_n_points": 25000,
    "radius": 40.0,
    "center": [0.0, 0.0, 0.0],
    "hollow": false,
    "inner_ratio": 0.5,
    "inner_n_points": null,
    "create_inner_mesh_from_outer_thickness": null,
    "fix_intersection": {
      "enabled": false,
      "min_thickness": 1.5,
      "mode": "inner"
    }
  },
  "grids": [
    {
      "id": "synthetic_harmonic",
      "source": "synthetic",
      "dataset": null,
      "params": {
        "n_lat": 360,
        "n_lon": 720,
        "l_degree": 6,
        "m_order": 4,
        "amplitude": 3500.0
      },
      "filepath": null,
      "synthetic_type": "spherical_harmonic",
      "ops": []
    }
  ],
  "outer_displacements": [
    {
      "id": "disp_harmonic",
      "name": "Spherical Harmonic Relief",
      "type": "GridDisplacer",
      "enabled": true,
      "grid_id": "synthetic_harmonic",
      "scale_mode": "auto_exagg",
      "scale": 0.0005,
      "vert_exagg": 50.0,
      "data_unit": "m",
      "reference_level": 0.0,
      "coastline_step": 0.6,
      "step_threshold": 0.0,
      "points": [],
      "lines": [],
      "polygons": [],
      "shapefile": null,
      "value": 0.0,
      "radius_deg": 2.0,
      "width_deg": 0.5,
      "profile": "flat",
      "height": 0.0,
      "mode": "add"
    }
  ],
  "inner_displacements": [],
  "colourers": [
    {
      "id": "col_viridis",
      "name": "Harmonic Viridis Colormap",
      "type": "GridColourer",
      "enabled": true,
      "target": "outer",
      "selection": "all",
      "blend_mode": "replace",
      "opacity": 1.0,
      "grid_id": "synthetic_harmonic",
      "cmap": "viridis",
      "vmin": -3500.0,
      "vmax": 3500.0,
      "symmetric": true,
      "use_banded_levels": false,
      "levels": [],
      "colors": [],
      "image_source": null,
      "image_path": null,
      "preprocessors": [],
      "color": null,
      "points": [],
      "lines": [],
      "polygons": [],
      "shapefile": null,
      "radius_deg": 2.0,
      "width_deg": 0.5,
      "feather_deg": 0.1,
      "symbol": null,
      "lat": null,
      "lon": null,
      "size_deg": 4.0,
      "rotation_deg": 0.0,
      "text": null,
      "font_path": null,
      "mark_north": false,
      "mark_south": false,
      "north_text": "N",
      "south_text": "S"
    }
  ],
  "filaments": {
    "enabled": false,
    "preset": "TERRAIN_4",
    "spools": [],
    "base_layers": 3,
    "top_layers": 4,
    "layer_height": 0.16,
    "quantize_preview": false
  },
  "magnets": {
    "enabled": false,
    "count": 4,
    "Optimize_positions": true,
    "optimize_positions": true,
    "diameter": 5.0,
    "height": 2.0,
    "clearance": 0.15,
    "min_margin": 1.5,
    "boss_thickness": 1.8,
    "manual_angles": [],
    "magnet_type": "cylindrical",
    "width": 5.0,
    "length": 10.0,
    "embed_depth": 0.2
  },
  "export": {
    "split_hemispheres": false,
    "format": "stl",
    "dual_files": false,
    "filament_mode": "monochrome",
    "output_dir": "outputs",
    "filename_prefix": "example_1_procedural_globe"
  }
}
