{
  "$schema": "../../schemas/globe_project.schema.json",
  "schema_version": "1.0",
  "metadata": {
    "id": "example_3_earth_topography",
    "name": "Example 3: High-Resolution Earth Hypsometric Relief",
    "description": "Classic 50mm Earth physical relief globe using ETOPO 2022 at 40x vertical exaggeration, 0.8mm coastline step, and high-contrast 'terrain' bathymetric/topographic colouring.",
    "category": "examples",
    "collection": "Standard Examples",
    "author": "Globe3D Studio",
    "tags": ["earth", "topography", "bathymetry", "etopo", "terrain", "relief"]
  },
  "mode": "custom",
  "paleo_config": {
    "enabled": false,
    "age": 0.0,
    "name": null,
    "resolution": "6m",
    "plate_model": "PALEOMAP",
    "data_dir": null,
    "vert_exagg": 40.0,
    "coastline_step": 0.0,
    "color_mode": "paleoatlas",
    "cmap": "terrain",
    "filament_spools": [],
    "band_thresholds": [],
    "tracked_locations": [],
    "mark_poles": false,
    "pole_style": "NS_letters",
    "pole_label_size_deg": 5.0,
    "location_marker_size_deg": 3.5
  },
  "geometry": {
    "distribution": "fibonacci",
    "n_points": 500000,
    "preview_n_points": 40000,
    "radius": 50.0,
    "center": [0.0, 0.0, 0.0],
    "hollow": true,
    "inner_ratio": 0.65,
    "inner_n_points": 50000,
    "create_inner_mesh_from_outer_thickness": null,
    "fix_intersection": {
      "enabled": true,
      "min_thickness": 1.8,
      "mode": "inner"
    }
  },
  "grids": [
    {
      "id": "etopo_earth",
      "source": "online",
      "dataset": "topography.earth",
      "params": {
        "resolution": "10m"
      },
      "filepath": "../inputs/ETOPO_2022_v1_60s_N90W180_surface.nc",
      "synthetic_type": null,
      "ops": []
    }
  ],
  "outer_displacements": [
    {
      "id": "disp_earth_relief",
      "name": "ETOPO Global Relief (40x + 0.8mm Coast Step)",
      "type": "GridDisplacer",
      "enabled": true,
      "grid_id": "etopo_earth",
      "scale_mode": "auto_exagg",
      "scale": 0.00031,
      "vert_exagg": 40.0,
      "data_unit": "m",
      "reference_level": 0.0,
      "coastline_step": 0.8,
      "step_threshold": 0.0,
      "points": [],
      "lines": [],
      "polygons": [],
      "shapefile": null,
      "value": 0.0,
      "radius_deg": 2.0,
      "width_deg": 0.5,
      "profile": "flat",
      "height": 0.0,
      "mode": "add"
    }
  ],
  "inner_displacements": [],
  "colourers": [
    {
      "id": "col_terrain_hypsometric",
      "name": "ETOPO Terrain Hypsometry (-6500m to +6500m)",
      "type": "GridColourer",
      "enabled": true,
      "target": "outer",
      "selection": "outward_facing",
      "blend_mode": "replace",
      "opacity": 1.0,
      "grid_id": "etopo_earth",
      "cmap": "terrain",
      "vmin": -6500.0,
      "vmax": 6500.0,
      "symmetric": true,
      "use_banded_levels": false,
      "levels": [],
      "colors": [],
      "image_source": null,
      "image_path": null,
      "preprocessors": [],
      "color": null,
      "points": [],
      "lines": [],
      "polygons": [],
      "shapefile": null,
      "radius_deg": 2.0,
      "width_deg": 0.5,
      "feather_deg": 0.1,
      "symbol": null,
      "lat": null,
      "lon": null,
      "size_deg": 4.0,
      "rotation_deg": 0.0,
      "text": null,
      "font_path": null,
      "mark_north": false,
      "mark_south": false,
      "north_text": "N",
      "south_text": "S"
    },
    {
      "id": "col_inner_dark",
      "name": "Inner Cavity Charcoal",
      "type": "ConstantColourer",
      "enabled": true,
      "target": "inner",
      "selection": "all",
      "blend_mode": "replace",
      "opacity": 1.0,
      "grid_id": null,
      "cmap": "terrain",
      "vmin": null,
      "vmax": null,
      "symmetric": false,
      "use_banded_levels": false,
      "levels": [],
      "colors": [],
      "image_source": null,
      "image_path": null,
      "preprocessors": [],
      "color": "#475569",
      "points": [],
      "lines": [],
      "polygons": [],
      "shapefile": null,
      "radius_deg": 2.0,
      "width_deg": 0.5,
      "feather_deg": 0.1,
      "symbol": null,
      "lat": null,
      "lon": null,
      "size_deg": 4.0,
      "rotation_deg": 0.0,
      "text": null,
      "font_path": null,
      "mark_north": false,
      "mark_south": false,
      "north_text": "N",
      "south_text": "S"
    }
  ],
  "filaments": {
    "enabled": false,
    "preset": "TERRAIN_4",
    "spools": [],
    "base_layers": 3,
    "top_layers": 4,
    "layer_height": 0.16,
    "quantize_preview": false
  },
  "magnets": {
    "enabled": true,
    "count": 4,
    "Optimize_positions": true,
    "optimize_positions": true,
    "diameter": 5.0,
    "height": 2.0,
    "clearance": 0.15,
    "min_margin": 1.5,
    "boss_thickness": 1.8,
    "manual_angles": [],
    "magnet_type": "cylindrical",
    "width": 5.0,
    "length": 10.0,
    "embed_depth": 0.2
  },
  "export": {
    "split_hemispheres": true,
    "format": "obj",
    "dual_files": true,
    "filament_mode": "vertex_color",
    "output_dir": "outputs",
    "filename_prefix": "example_3_earth_topography"
  }
}
