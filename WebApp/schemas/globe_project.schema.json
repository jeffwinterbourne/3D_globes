            "additionalProperties": true
          },
          "default": []
        },
        "lines": {
          "type": "array",
          "default": []
        },
        "polygons": {
          "type": "array",
          "default": []
        },
        "shapefile": {
          "type": ["string", "null"],
          "default": null
        },
        "radius_deg": {
