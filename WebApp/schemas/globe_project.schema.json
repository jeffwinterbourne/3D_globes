                  "median_filter",
                  "bilateral_filter",
                  "quantize_colors"
                ]
              },
              "strength": { "type": "number" },
              "kernel_size": { "type": "integer" },
              "d": { "type": "integer" },
              "sigma_color": { "type": "number" },
              "sigma_space": { "type": "number" },
              "n_colors": { "type": "integer" }
            },
            "additionalProperties": true
          }
        },
        "color": {
          "oneOf": [
